#!/usr/bin/with-contenv bashio
# ==============================================================================
# Verifica periodicamente uso de espaço e saúde SMART dos discos, disparando
# notificações persistentes no próprio Home Assistant quando algo passa do
# limite. Roda em loop infinito como serviço de longa duração (mesmo padrão
# do webserver) — desativável via monitor_enabled na Configuração do add-on.
# ==============================================================================

ROOT_MOUNT="/mnt/hd_externo"

if ! bashio::config.true 'monitor_enabled'; then
    bashio::log.info "Monitor de disco/SMART desativado (monitor_enabled=false). Serviço ocioso."
    while true; do sleep 3600; done
fi

INTERVAL_MIN=$(bashio::config 'monitor_interval_minutes')
ALERT_PERCENT=$(bashio::config 'disk_usage_alert_percent')

bashio::log.info "Monitor de disco/SMART iniciado (intervalo: ${INTERVAL_MIN} min, alerta em ${ALERT_PERCENT}% de uso)."

notify() {
    local id="$1" title="$2" message="$3"
    php83 -r '
        $token = getenv("SUPERVISOR_TOKEN");
        if (!$token) { fwrite(STDERR, "SUPERVISOR_TOKEN ausente\n"); exit(1); }
        $ch = curl_init("http://supervisor/core/api/services/persistent_notification/create");
        curl_setopt_array($ch, [
            CURLOPT_POST => true,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT => 10,
            CURLOPT_HTTPHEADER => ["Authorization: Bearer $token", "Content-Type: application/json"],
            CURLOPT_POSTFIELDS => json_encode([
                "notification_id" => $argv[1],
                "title" => $argv[2],
                "message" => $argv[3],
            ], JSON_UNESCAPED_UNICODE),
        ]);
        curl_exec($ch);
        curl_close($ch);
    ' -- "$id" "$title" "$message"
}

while true; do
    # --- Uso de espaço por disco montado ---
    if [ -d "${ROOT_MOUNT}" ]; then
        for d in "${ROOT_MOUNT}"/*/; do
            [ -d "$d" ] || continue
            if mountpoint -q "$d" 2>/dev/null; then
                label=$(basename "$d")
                pct=$(df -P "$d" 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5}')
                if [ -n "$pct" ] && [ "$pct" -ge "$ALERT_PERCENT" ] 2>/dev/null; then
                    notify "file_full_disk_${label}" "HD quase cheio: ${label}" \
                        "O disco '${label}' está com ${pct}% de uso (limite configurado: ${ALERT_PERCENT}%)."
                fi
            fi
        done
    fi

    # --- SMART dos discos físicos (ignora qualquer coisa hassos-*, nunca mexe no sistema) ---
    for dev_path in /dev/disk/by-label/*; do
        [ -e "$dev_path" ] || continue
        label=$(basename "$dev_path")
        case "$label" in
            hassos*) continue ;;
        esac

        real_dev=$(readlink -f "$dev_path")
        parent_dev=$(lsblk -ndo PKNAME "$real_dev" 2>/dev/null)
        [ -n "$parent_dev" ] && real_dev="/dev/${parent_dev}"

        smart_out=$(smartctl -H "$real_dev" 2>/dev/null)
        if echo "$smart_out" | grep -qi "FAILED"; then
            notify "file_full_smart_$(basename "$real_dev")" "Alerta SMART: ${label}" \
                "O disco '${label}' (${real_dev}) reportou FALHA no teste de saúde SMART. Considere fazer backup imediatamente."
        fi
    done

    sleep "$((INTERVAL_MIN * 60))"
done
