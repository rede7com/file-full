#!/usr/bin/with-contenv bashio
if bashio::config.true 'time_machine_enabled' || bashio::config.true 'smb_enabled'; then
    bashio::log.info "Iniciando Avahi (mDNS/Bonjour) para anúncio do SMB na rede..."
    exec avahi-daemon --no-chroot -f /etc/avahi/avahi-daemon.conf
else
    while true; do sleep 3600; done
fi
