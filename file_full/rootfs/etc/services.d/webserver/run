#!/usr/bin/with-contenv bashio
# Servidor embutido do PHP em vez de Apache: o Apache se recusa a rodar como
# root (trava do próprio binário), e root é necessário aqui pra gravar em
# pastas montadas do host (/config, discos ext4) sem depender de quem é o
# dono original dos arquivos. Ver README/histórico do add-on para detalhes.
bashio::log.info "Iniciando servidor PHP embutido na porta 8099..."
cd /var/www/html
exec php83 -S 0.0.0.0:8099 -t /var/www/html
